.obsidian/workspace-sync.json
.obsidian/cache
.obsidian/plugins/*/data.json
.obsidian/plugins/*/main.js

# 系统
.DS_Store
Thumbs.db
desktop.ini
# 敏感原文备份（不推送 GitHub）
_private_bak/
